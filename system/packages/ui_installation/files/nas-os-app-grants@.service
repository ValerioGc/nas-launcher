# Writes validated permissions for application %i to its systemd unit drop-in.
# The launcher starts apply-app-grants.sh after application installation, updates,
# or removal. The matching polkit rule permits only this helper.

[Unit]
Description=Grants of the NAS application %i

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nas-os/apply-app-grants.sh %i
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/nas-os
ReadWritePaths=/etc/systemd/system
NoNewPrivileges=yes
# Reads private launcher requests using CAP_DAC_READ_SEARCH, writes root-owned
# unit drop-ins, and reloads systemd through its Unix socket. Network access and
# other capabilities are excluded.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
