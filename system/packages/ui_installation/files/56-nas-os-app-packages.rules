/*
 * Lets the launcher have the Debian packages an application asks for installed and removed, and
 * nothing else: the verb `start` of `nas-os-app-packages@<id>.service`, whose helper installs only
 * the packages of its own fixed list.
 *
 * Installed by `system/packages/ui_installation/install.sh`. Without it an application that needs
 * a system package is not installed, and the launcher says what polkit refused.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'nas-os' &&
    /^nas-os-app-packages@[A-Za-z0-9_-]{1,64}\.service$/.test(action.lookup('unit') || '') &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
