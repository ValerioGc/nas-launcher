/*
 * Allows the nas-os service user to start nas-os-app-packages@<id>.service.
 * The helper installs or removes application dependencies from a fixed package list.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'nas-os' &&
    /^nas-os-app-packages@[A-Za-z0-9_-]{1,64}\.service$/.test(action.lookup('unit') || '') &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
