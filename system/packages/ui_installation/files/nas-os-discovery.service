# Opens the discovery of NAS Finder (UDP 39877) to the local network while the option of the
# security center is on, through apply-discovery.sh and the set `nas_discovery` of the base
# firewall, and closes it when the option is off. The launcher starts it after a change and at its
# own start; polkit lets it start nothing else (63-nas-os-discovery.rules). Installed by
# `system/packages/ui_installation/install.sh`.

[Unit]
Description=Discovery of the NAS on the local network
After=nas-os-base-firewall.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nas-os/apply-discovery.sh
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/nas-os
NoNewPrivileges=yes
# It only puts a port in a set of the base firewall, over netlink.
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
