# Installs verified wizard, gateway, and launcher releases through a privileged helper.
# The helper backs up state, stops services, installs updates, and restarts the NAS.
# Failures restore the backup and restart the previous launcher.
# The launcher starts the unit explicitly after checksum verification.

[Unit]
Description=nas-os: install the downloaded releases of the wizard, the gateway and the launcher
Documentation=https://github.com/ValerioGc/nas-launcher

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nas-os/install-launcher-update.sh
TimeoutStartSec=45min

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
