/*
 * Allows the nas-os service user to start nas-os-sync-ports.service.
 * The helper manages the fixed Syncthing ports in the nas_sync firewall set
 * according to active application sync requests.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'nas-os' &&
    action.lookup('unit') === 'nas-os-sync-ports.service' &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
