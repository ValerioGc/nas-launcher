/*
 * Lets the launcher install a release it has already fetched and checked, and nothing else.
 *
 * Writing /usr/local/bin and restarting a unit need root, which the launcher is not: it leaves the
 * verified archive in its state directory and starts `nas-os-update.service`, which does the
 * work. This rule allows exactly that one unit and exactly the verb `start`.
 *
 * Installed by `system/packages/ui_installation/install.sh`; by hand, on Debian 13:
 *   sudo install -m 0644 system/packages/ui_installation/files/40-nas-os-update.rules /etc/polkit-1/rules.d/
 *   sudo systemctl restart polkit
 *
 * Without this rule the launcher still checks for releases and still downloads them; what it
 * cannot do is put one in place, and it says so instead of claiming it did.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'nas-os' &&
    action.lookup('unit') === 'nas-os-update.service' &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
