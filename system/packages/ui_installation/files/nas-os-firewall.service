# Access list of the NAS: this is what turns the rules saved in the launcher into a real filter.
#
# Launcher and gateway start this helper for the saved access list and HTTPS port.
# The polkit rule allows only the start of this unit.
#
# It runs as root because nftables is written by root: that is why the work is here and not inside
# the launcher, which is not root.

[Unit]
Description=nas-os: apply the access list to nftables
Documentation=https://github.com/ValerioGc/nas-launcher
After=nftables.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nas-os/apply-access-rules.sh

# It has to talk to netfilter, so neither PrivateNetwork nor the capability drop that would stop
# it: CAP_NET_ADMIN is precisely the permission this unit exists to use.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
