/*
 * Lets the launcher give an installed application the paths its manifest asks for, and nothing
 * else: the verb `start` of `nas-os-app-grants@<id>.service`, whose helper turns only the paths it
 * knows into a drop-in of `nas-app@<id>.service`.
 *
 * Installed by `system/packages/ui_installation/install.sh`. Without it an application is installed
 * with the defaults of the template, and the launcher says what polkit refused.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'nas-os' &&
    /^nas-os-app-grants@[A-Za-z0-9_-]{1,64}\.service$/.test(action.lookup('unit') || '') &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
