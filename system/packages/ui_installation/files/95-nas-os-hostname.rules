/*
 * Allows the nas-os service user to start nas-os-hostname.service.
 * The helper applies the validated NAS hostname.
 */
polkit.addRule(function(action, subject) {
  if (action.id === 'org.freedesktop.systemd1.manage-units' &&
      subject.user === 'nas-os' &&
      action.lookup('unit') === 'nas-os-hostname.service' &&
      action.lookup('verb') === 'start') {
    return polkit.Result.YES;
  }
});
