// The launcher may start only the fixed helper that applies its validated NAS name.
polkit.addRule(function(action, subject) {
  if (action.id === 'org.freedesktop.systemd1.manage-units' &&
      subject.user === 'nas-os' &&
      action.lookup('unit') === 'nas-os-hostname.service' &&
      action.lookup('verb') === 'start') {
    return polkit.Result.YES;
  }
});
