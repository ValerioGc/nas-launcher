# Runs a validated process action through act-on-process.sh.
# The instance name contains the action, PID, and process start time.
# The launcher starts the helper from the process widget under the matching polkit rule.

[Unit]
Description=Process action %i of the NAS
# Unloads completed instances, including failed requests.
CollectMode=inactive-or-failed

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nas-os/act-on-process.sh %i
TimeoutStartSec=100
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
# Retains CAP_KILL to signal processes and uses the systemd Unix socket for restarts.
# Host /proc visibility supports target validation. Network access is unnecessary.
CapabilityBoundingSet=CAP_KILL
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
