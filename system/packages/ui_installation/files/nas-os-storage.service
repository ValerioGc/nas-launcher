[Unit]
Description=NAS data volume discovery and user storage
After=local-fs.target nas-os.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nas-os-axum --reconcile-storage
TimeoutStartSec=60
# The automatic keys of the encrypted volumes, decrypted only for the time of one open.
RuntimeDirectory=nas-os-storage
RuntimeDirectoryMode=0700
# The network disks that connect by themselves: their server found by its name, and the base
# firewall told to let the kernel reach it.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_IPC_LOCK CAP_NET_ADMIN
NoNewPrivileges=yes
PrivateMounts=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
