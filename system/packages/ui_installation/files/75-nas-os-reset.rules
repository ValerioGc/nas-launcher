/*
 * Allows the nas-os service user to start nas-os-reset.service.
 * The launcher requests a reset after gateway verification of the account password.
 * The privileged helper removes application state and restarts the setup wizard.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'nas-os' &&
    action.lookup('unit') === 'nas-os-reset.service' &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
