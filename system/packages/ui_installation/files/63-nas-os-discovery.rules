/*
 * Allows the nas-os service user to start nas-os-discovery.service.
 * The helper manages UDP 39877 in the nas_discovery firewall set according to
 * the Security Center discovery setting.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'nas-os' &&
    action.lookup('unit') === 'nas-os-discovery.service' &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
