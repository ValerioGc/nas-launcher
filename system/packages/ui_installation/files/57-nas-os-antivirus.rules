/*
 * Allows the nas-os service user to start nas-os-antivirus.service.
 * The helper validates each antivirus request before execution.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    subject.user === 'nas-os' &&
    action.lookup('unit') === 'nas-os-antivirus.service' &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
