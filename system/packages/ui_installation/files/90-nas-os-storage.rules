// The launcher may refresh the fixed storage unit after wizard provisioning.
polkit.addRule(function(action, subject) {
  if (action.id === 'org.freedesktop.systemd1.manage-units' &&
      subject.user === 'nas-os' &&
      (action.lookup('unit') === 'nas-os-storage.service' ||
       action.lookup('unit') === 'nas-os-storage-initialize.service' ||
       action.lookup('unit') === 'nas-os-storage-rename.service' ||
       action.lookup('unit') === 'nas-os-storage-eject.service' ||
       action.lookup('unit') === 'nas-os-storage-smart.service') &&
      action.lookup('verb') === 'start') {
    return polkit.Result.YES;
  }
});
