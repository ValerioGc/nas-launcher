# Hardware clock alarm: this is what switches the NAS back on after a scheduled shutdown.
#
# It does not start on its own and it is not enabled at boot: the launcher starts it, right before
# powering off, after writing the time to /var/lib/nas-os/wakealarm. The permission to start
# it (and only this unit) comes from the polkit rule installed alongside.
#
# It runs as root because /sys/class/rtc/rtc0/wakealarm is written by root only: that is why the
# work is here and not inside the launcher, which is not root.

[Unit]
Description=nas-os: set the hardware clock alarm
Documentation=https://github.com/ValerioGc/nas-launcher

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nas-os/wake-alarm.sh

# The one thing it has to be able to write is the clock: no ProtectKernelTunables, which would
# make /sys read only and break exactly the write this unit exists for.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
