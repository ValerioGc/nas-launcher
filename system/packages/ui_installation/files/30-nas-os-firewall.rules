/*
 * Allows the launcher and gateway service users to start nas-os-firewall.service.
 * The helper applies the saved access list and HTTPS port to the NAS firewall.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === 'org.freedesktop.systemd1.manage-units' &&
    (subject.user === 'nas-os' || subject.user === 'nas-os-gateway') &&
    action.lookup('unit') === 'nas-os-firewall.service' &&
    action.lookup('verb') === 'start'
  ) {
    return polkit.Result.YES;
  }
});
