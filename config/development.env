# The settings of a development copy, read by `npm run backend:dev` through the shell. Same keys as
# production.env. A variable already set on the command line wins (`PORT=3001 npm run backend:dev`).

PORT=${PORT:-3000}

NAS_POWER_MODE=${NAS_POWER_MODE:-simulated}
NAS_NETWORK_MODE=${NAS_NETWORK_MODE:-simulated}
NAS_FIREWALL_MODE=${NAS_FIREWALL_MODE:-simulated}
NAS_PACKAGES_MODE=${NAS_PACKAGES_MODE:-simulated}
NAS_APPS_MODE=${NAS_APPS_MODE:-simulated}
NAS_APT_MODE=${NAS_APT_MODE:-simulated}
NAS_TERMINAL_MODE=${NAS_TERMINAL_MODE:-simulated}
NAS_TOKEN_MODE=${NAS_TOKEN_MODE:-simulated}
NAS_HOSTNAME_MODE=${NAS_HOSTNAME_MODE:-simulated}
NAS_RESET_MODE=${NAS_RESET_MODE:-simulated}
NAS_PROCESSES_MODE=${NAS_PROCESSES_MODE:-simulated}

NAS_LAUNCHER_REPOSITORY=${NAS_LAUNCHER_REPOSITORY:-}
NAS_LAUNCHER_PROVIDER=${NAS_LAUNCHER_PROVIDER:-github}
