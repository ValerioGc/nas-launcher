# The settings of the launcher on the NAS. The release installs this file as
# /etc/nas-os/nas-os.env, replacing it at every update. A value changed on the machine goes in
# /etc/nas-os/nas-os.local.env, which the installation never touches and which wins over this one.
# One KEY=VALUE per line, no quotes: systemd reads it, and so does a shell.

# The port the launcher listens on
PORT=3000

NAS_POWER_MODE=real
NAS_NETWORK_MODE=real
NAS_FIREWALL_MODE=real
NAS_PACKAGES_MODE=real
NAS_APPS_MODE=real
NAS_APT_MODE=real
NAS_TERMINAL_MODE=real
NAS_STORAGE_MODE=real
NAS_ENCRYPTION_MODE=real
NAS_NETWORK_DISKS_MODE=real
NAS_HOSTNAME_MODE=real
NAS_RESET_MODE=real
NAS_PROCESSES_MODE=real
NAS_TOKEN_MODE=real

NAS_LAUNCHER_REPOSITORY=ValerioGc/nas-launcher
NAS_GATEWAY_REPOSITORY=ValerioGc/nas-gateway
NAS_WIZARD_REPOSITORY=ValerioGc/nas-wizard
NAS_LAUNCHER_PROVIDER=github
