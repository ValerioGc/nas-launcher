# The settings of the launcher on the NAS. The release installs this file as
# /etc/nas-os/nas-os.env, replacing it at every update; a value changed on the machine goes in
# /etc/nas-os/nas-os.local.env, which the installation never touches and which wins over this one.
# One KEY=VALUE per line, no quotes: systemd reads it, and so does a shell.

# The port the launcher listens on, on the loopback only: the gateway forwards to it.
PORT=3000

# What the launcher really does to the machine. Any value other than `real` leaves that half
# simulated or read only, which is what a development copy wants.
# Reboot and shutdown.
NAS_POWER_MODE=real
# Joining and leaving networks.
NAS_NETWORK_MODE=real
# Turning the allowed addresses into an nftables filter in front of the NAS.
NAS_FIREWALL_MODE=real
# Reaching the repositories to install and update applications.
NAS_PACKAGES_MODE=real
# Starting and stopping the installed applications.
NAS_APPS_MODE=real
# Installing the Debian upgrades.
NAS_APT_MODE=real
# Opening the shell of the terminal and following the system journal.
NAS_TERMINAL_MODE=real
# Reconciling the wizard user's data volumes through the dedicated root unit.
NAS_STORAGE_MODE=real
# Applying the configured NAS name as the machine's static hostname.
NAS_HOSTNAME_MODE=real
# Resetting the NAS from the settings and starting the wizard again.
NAS_RESET_MODE=real
# Terminating processes and restarting services from the process widget.
NAS_PROCESSES_MODE=real
# Storing the release token in the encrypted credential store.
NAS_TOKEN_MODE=real

# Where the launcher looks for its own releases, as `owner/name`. Empty means it does not look.
NAS_LAUNCHER_REPOSITORY=ValerioGc/nas-launcher
# The gateway and the wizard update with the launcher, from the repositories beside it.
NAS_GATEWAY_REPOSITORY=ValerioGc/nas-gateway
NAS_WIZARD_REPOSITORY=ValerioGc/nas-wizard
NAS_LAUNCHER_PROVIDER=github
